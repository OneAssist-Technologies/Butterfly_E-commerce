generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  OPERATOR
  CATALOG_MANAGER
}

enum OrderStatus {
  Processing
  Dispatched
  Delivered
  Cancelled
}

enum EnquiryStatus {
  New
  Contacted
  Closed
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String?
  role       Role     @default(CUSTOMER)
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
  reviews    Review[]

  @@map("users")
}

model Product {
  id                 String      @id @default(uuid())
  model              String      @unique
  name               String
  size               String
  screenSizeCategory String?
  badge              String?
  image              String
  images             String[]    @default([])
  resolution         String
  resolutionCategory String?
  os                 String
  smartOS            String?
  smartCategory      String?
  sound              String
  displayTech        String?
  price              String
  numericPrice       Int
  priceCategory      String?
  brand              String      @default("Butterfly")
  isFilledButton     Boolean     @default(false)
  buttonLabel        String?
  featuredRank       Int?
  inStock            Boolean     @default(true)
  features           String[]    @default([])
  keyFeatures        String[]    @default([])
  technicalSpecs     Json?
  warrantyInstallation String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  orderItems         OrderItem[]
  reviews            Review[]

  @@map("products")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int      @default(5)
  title     String?
  comment   String
  userName  String
  userEmail String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  customerName  String
  email         String
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  amount        String
  numericAmount Int
  payment       String      @default("Prepaid (UPI)")
  status        OrderStatus @default(Processing)
  date          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId    String?
  productModel String
  productName  String
  price        String
  numericPrice Int
  quantity     Int      @default(1)
  lineTotal    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("order_items")
}

model Enquiry {
  id           String        @id @default(uuid())
  enquiryNumber String       @unique
  name         String
  phone        String
  email        String
  city         String
  message      String?
  productModel String
  productPrice String?
  date         String
  status       EnquiryStatus @default(New)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("enquiries")
}
